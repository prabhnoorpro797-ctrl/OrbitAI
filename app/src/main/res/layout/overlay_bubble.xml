<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_assistant_bubble"
    android:padding="8dp">
    <ImageButton android:id="@+id/bubbleMic" android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@android:drawable/ic_btn_speak_now"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Open Orbit" />
    <ImageButton android:id="@+id/bubbleClose" android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Close" />
</LinearLayout>
