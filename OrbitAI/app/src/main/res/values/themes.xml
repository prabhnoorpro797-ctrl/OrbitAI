        <item name="colorPrimaryVariant">@color/orbit_blue</item>
        <item name="colorOnPrimary">@color/orbit_navy</item>
        <item name="colorSecondary">@color/orbit_blue</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/orbit_navy_dark</item>
