<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">
    <EditText android:id="@+id/deviceName" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="Name" />
    <EditText android:id="@+id/deviceType" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="Type (light, plug, fan…)" />
    <EditText android:id="@+id/deviceAddress" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="Address / entity id / IP" />
</LinearLayout>
